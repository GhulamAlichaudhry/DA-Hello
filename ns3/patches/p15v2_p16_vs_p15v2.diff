+  }
 
 private:
+  double hostScore (double e, uint32_t nb, double V) const
+  {
+    const double eIni = p_.config ().eIni;
+    return (eIni > 0.0 ? e / eIni : 0.0) + 0.01 * static_cast<double> (nb) + p_.config ().gamma * V;
+  }
+  bool isVoidNode (uint32_t j) const { return p_.candidateSet (j).empty (); }
+  int daFire (uint32_t j)
+  {
+    if (!sched_ || j >= p_.nodes ().size ()) return 0;
+    const double now = Simulator::Now ().GetSeconds ();
+    const uint32_t n = static_cast<uint32_t> (p_.nodes ().size ());
+    const auto &nj = p_.nodes ()[j];
+    bool up = false;
+    double zUpMax = -1e300;
+    for (uint32_t i = 0; i < n; ++i)
+      {
+        if (i == j) continue;
+        if (heard_ && !p_.fresh (j, i)) continue;
+        dahello::FilterPeek pk;
+        double zi = nj.z;
+        if (sched_->peekFilter (j, i, pk) && pk.heard && std::isfinite (pk.heldZ))
+          {
+            zi = pk.heldZ;
+          }
+        else if (!sched_->zohHeard (j, i))
+          {
+            continue;
+          }
+        if (zi > nj.z)
+          {
+            up = true;
+            zUpMax = std::max (zUpMax, zi);
+          }
+      }
+    const bool voidNow = isVoidNode (j);
+    const bool voidFlip = (voidNow ? 1 : 0) != voidLast_[j];
+    if (!up) return 0;
+    if (voidFlip)
+      {
+        daI_[j] = daImin_;
+        daHold_[j] = now + daI_[j];
+        return 1;
+      }
+    if (voidNow) return 0;
+    const uint32_t nb = static_cast<uint32_t> (p_.candidateSet (j).size ());
+    const double sAdv = hostScore (eLast_[j], nbLast_[j], vLast_[j]);
+    const double sNow = hostScore (p_.energy (j), nb, p_.ownV (j));
+    if (sAdv == sNow) return 0;
+    bool flip = false;
+    for (uint32_t k = 0; k < n && !flip; ++k)
+      {
+        if (k == j) continue;
+        if (heard_ && !p_.fresh (j, k)) continue;
+        dahello::FilterPeek pk;
+        if (!sched_->peekFilter (j, k, pk) || !pk.heard) continue;
+        if (!(pk.heldZ < zUpMax)) continue;
+        const double Vk = std::isfinite (pk.heldE) ? 0.0 : 0.0; // V from host hold below
+        (void)Vk;
+        // Peer score from held energy + number; V unknown on Dahello FilterPeek → 0
+        const double ek = std::isfinite (pk.heldE) ? pk.heldE : p_.config ().eIni;
+        const double sk = hostScore (ek, 0u, 0.0);
+        const double gA = sAdv - sk, gN = sNow - sk;
+        if ((gA > 0.0) != (gN > 0.0) && std::fabs (gN) >= daMargin_) flip = true;
+      }
+    if (!flip) return 0;
+    if (daMode_ == 2)
+      {
+        if (now + 1e-9 < daHold_[j]) return 0;
+        daI_[j] = std::min (2.0 * daI_[j], daImax_);
+        daHold_[j] = now + daI_[j];
+      }
+    return 2;
+  }
+  bool stateDirtyFire (uint32_t j)
+  {
+    if (daMode_ <= 0) return false;
+    const int d = daFire (j);
+    if (j < pendCause_.size ()) pendCause_[j] = d;
+    return d != 0;
+  }
+  void noteStateSent (uint32_t j)
+  {
+    if (j >= vLast_.size ()) return;
+    vLast_[j] = p_.ownV (j);
+    voidLast_[j] = isVoidNode (j) ? 1 : 0;
+    eLast_[j] = p_.energy (j);
+    nbLast_[j] = static_cast<uint32_t> (p_.candidateSet (j).size ());
+  }
+  void afterDaTick ()
+  {
+    if (!sched_) return;
+    const uint32_t n = static_cast<uint32_t> (p_.nodes ().size ());
+    for (uint32_t j = 0; j < n; ++j)
+      {
+        if (sched_->linkFiredLastTick (j) || sched_->hostFiredLastTick (j))
+          noteStateSent (j);
+      }
+  }
+
